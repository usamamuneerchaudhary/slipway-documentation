{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Slipway",
  "description": "Define your Laravel CI/CD once in PHP. Compile it to GitHub Actions, Bitbucket Pipelines and GitLab CI.",
  "colors": {
    "primary": "#FF6A2B",
    "light": "#FF6A2B",
    "dark": "#E5551A"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 700
    }
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#F7FAFC",
      "dark": "#0B1D2E"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart",
          "presets-and-libraries"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "how-it-works",
          "security-model"
        ]
      },
      {
        "group": "Configuration",
        "pages": [
          "configuration",
          "stages-and-steps",
          "drivers",
          "provider-support",
          "policies",
          "notifications"
        ]
      },
      {
        "group": "Deployment",
        "pages": [
          "environments",
          "deployers",
          "laravel-cloud",
          "recipes",
          "ssh-server-setup"
        ]
      },
      {
        "group": "Extending",
        "pages": [
          "extending",
          "writing-a-driver"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "commands",
          "known-limitations-and-roadmap",
          "testing-and-contributing"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/usamamuneerchaudhary/laravel-slipway",
          "icon": "github"
        },
        {
          "anchor": "Packagist",
          "href": "https://packagist.org/packages/usamamuneerchaudhary/laravel-slipway",
          "icon": "box"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/usamamuneerchaudhary/laravel-slipway"
      },
      {
        "label": "Packagist",
        "href": "https://packagist.org/packages/usamamuneerchaudhary/laravel-slipway"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/usamamuneerchaudhary/laravel-slipway"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Slipway",
      "og:image": "/images/github-social-preview-1280x640.png",
      "twitter:card": "summary_large_image"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-94XPZQXY75"
    }
  }
}
